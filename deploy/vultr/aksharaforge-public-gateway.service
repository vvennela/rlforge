[Unit]
Description=AksharaForge restricted judge frontend
After=aksharaforge.service netbird.service
BindsTo=aksharaforge.service
PartOf=aksharaforge.service

[Service]
User=aksharaforge
Group=aksharaforge
WorkingDirectory=/opt/aksharaforge
EnvironmentFile=/etc/aksharaforge-netbird-gateway.env
Environment=PYTHONPATH=/opt/aksharaforge/src
ExecStart=/opt/aksharaforge/.venv/bin/python -m akshara_forge.studio.public_gateway --session /run/aksharaforge-demo/session.json --bind ${NETBIRD_BIND_IP}
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
