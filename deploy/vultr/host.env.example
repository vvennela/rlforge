AKSHARA_SANDBOX_RUNTIME=runsc
AKSHARA_SANDBOX_MEMORY=512m
AKSHARA_AGENT_PROVIDER=vultr
AKSHARA_AGENT_MODEL=qwen3.8-27b
# Set in the root-owned, mode-0600 /etc/aksharaforge.env file, not in Git.
VULTR_INFERENCE_API_KEY=
AKSHARA_GENERATOR_PROVIDER=vultr
AKSHARA_GENERATOR_MODEL=glm-5.3
# Optional OpenAI provider: AKSHARA_GENERATOR_PROVIDER=openai, model=gpt-6-astra
# OPENAI_API_KEY=
